---
import Icon from './Icon.astro';
import { FOOTER_LINKS, SITE } from '../data/site';

const year = new Date().getFullYear();
// 与 os.nju.edu.cn 页脚一致：显示「更新时间」而不是构建流水号
const buildDate = new Intl.DateTimeFormat('zh-CN', {
  dateStyle: 'long',
  timeZone: 'Asia/Shanghai',
}).format(new Date());
---

<footer id="footer">
  <div class="footer__inner wrap">
    <div class="footer-row">
      <div class="footer-block footer__about">
        <p>
          南阳理工学院-计算机与信息化处理协会是由南阳理工学院在校的 GNU/Linux
          爱好者发起并组成的团体，旨在搭建信息交流共享的平台，宣传自由软件的价值，提高自由软件社区文化氛围，推广自由软件的应用。
        </p>
      </div>

      <div class="footer-block footer__extras">
        <div class="footer__contact">
          <ul>
            {
              FOOTER_LINKS.map((item) => (
                <li>
                  <a href={item.url} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    <Icon name={item.icon} size={15} />
                    <span>{item.title}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="footer__logo">
          <img src="/static/logo.png" alt="CIPS @ NYIST" />
        </div>
      </div>
    </div>

    <div class="footer-legal">
      <p>© {year} 南阳理工学院-计算机与信息化处理协会（{SITE.name}）</p>
      <p>地址：{SITE.address}</p>
      <p>
        <a href={SITE.icp.url} target="_blank" rel="noopener">{SITE.icp.number}</a>
        <span aria-hidden="true"> · </span>
        <a href={SITE.police.url} target="_blank" rel="noopener">{SITE.police.number}</a>
      </p>
      <p>
        更新时间：{buildDate} · Powered by <a href="https://astro.build/" target="_blank" rel="noopener"
          >Astro</a
        >
      </p>
    </div>
  </div>
</footer>
