---
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';
import { HOME_ABOUT, SERVICE_TILES } from '../data/site';

const link = (item: { url: string; external?: boolean }) =>
  item.external ? { target: '_blank', rel: 'noopener' } : {};

/**
 * 开源镜像站直接用官方矢量 Tux（CC0，garrett/Tux，原始插画 Larry Ewing）。
 * 放在 public/static/ 下的以下任一文件会被自动采用，都没有就退回
 * src/utils/icons.ts 里自绘的 Tux。
 */
const TUX_CANDIDATES = ['public/static/tux.svg', 'public/static/tux-bw.svg'];
const tuxFile = TUX_CANDIDATES.find((file) => fs.existsSync(path.join(process.cwd(), file)));
/** public/static/tux-bw.svg -> /static/tux-bw.svg */
const tuxSrc = tuxFile ? `/${tuxFile.replace(/^public\//, '')}` : null;
---

<!-- 三段式：左磁贴块 | 右侧面板（简介 + 右磁贴块），详见 global.css 的 home tiles 段 -->
<nav class="lug-nav" aria-label="服务入口">
  <div class="lug-tiles lug-tiles--solid">
    {
      SERVICE_TILES.left.map((item) => (
        <a href={item.url} class={`tile tile--${item.color}`} {...link(item)}>
          {item.icon === 'tile-mirror' && tuxSrc ? (
            <img class="tile__icon tile__icon--file" src={tuxSrc} alt="" width="44" height="44" />
          ) : (
            <Icon name={item.icon} size={44} strokeWidth={1.5} class="tile__icon" />
          )}
          <span>{item.title}</span>
        </a>
      ))
    }
  </div>

  <div class="lug-side">
    <div class="lug-about">
      {HOME_ABOUT.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="lug-tiles lug-tiles--plain">
      {
        SERVICE_TILES.right.map((item) => (
          <a href={item.url} class={`tile tile--${item.color} tile--plain`} {...link(item)}>
            <Icon name={item.icon} size={44} strokeWidth={1.5} class="tile__icon" />
            <span>{item.title}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>
