---
import Icon from './Icon.astro';
import { plainExcerpt, postPath, type PostCollection, type PostEntry } from '../utils/content';

interface Props {
  entries: PostEntry[];
  collection: PostCollection;
  heading?: string;
  /** 列表页展示摘要，首页只展示标题与日期 */
  showExcerpt?: boolean;
}

const { entries, collection, heading, showExcerpt = true } = Astro.props;
---

<section class="archive">
  {
    heading && (
      <h2 class="archive__subtitle">
        <a href={`/${collection}/`}>{heading}</a>
      </h2>
    )
  }
  <ul class="archive__list">
    {
      entries.map((entry) => (
        <li class="archive__item">
          <h3 class="archive__item-title">
            <a href={postPath(collection, entry)}>{entry.data.title}</a>
          </h3>
          <p class="archive__item-meta">
            <span class="meta__item">
              <Icon name="calendar" size={14} />
              <time datetime={entry.data.date}>{entry.data.date}</time>
            </span>
            {entry.data.author && (
              <span class="meta__item">
                <Icon name="user" size={14} />
                {entry.data.author}
              </span>
            )}
            {entry.data.source && (
              <span class="meta__item">
                <Icon name="link" size={14} />
                来源：{entry.data.source}
              </span>
            )}
          </p>
          {showExcerpt && <p class="archive__item-excerpt">{plainExcerpt(entry.body)}</p>}
        </li>
      ))
    }
  </ul>
</section>
