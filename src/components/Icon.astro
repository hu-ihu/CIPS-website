---
import { ICONS, type IconName } from '../utils/icons';

interface Props {
  /** src/utils/icons.ts 中的图标名 */
  name: IconName;
  /** 边长（px），图标是正方形的 */
  size?: number;
  class?: string;
  /** 描边粗细：小尺寸用默认值，大尺寸（磁贴）可略微调细 */
  strokeWidth?: number;
}

const { name, size = 20, class: className, strokeWidth = 1.75 } = Astro.props;

// 构建期守卫：图标名不存在时直接让构建失败，而不是静默渲染一个空 svg。
// （项目没有装 astro check / typescript，用运行时断言拿到同样的报错效果。）
const body = ICONS[name];
if (!body) {
  throw new Error(`未知图标 "${name}"，可用图标见 src/utils/icons.ts：${Object.keys(ICONS).join(', ')}`);
}
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
