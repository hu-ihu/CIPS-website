---
import BaseLayout from './BaseLayout.astro';
import type { PostCollection } from '../utils/content';

interface Props {
  title: string;
  collection: PostCollection;
  date: string;
  author?: string;
  source?: string;
  categories?: string[];
  tags?: string[];
  /** 旧站 news 用 nyist-1.jpg，planet 用 galaxy-1.jpg，overlay_filter 均为 0.2 */
  heroImage?: string;
  heroFilter?: number;
}

const {
  title,
  collection,
  date,
  author,
  source,
  categories = [],
  tags = [],
  heroImage = collection === 'planet' ? '/static/splash/galaxy-1.jpg' : '/static/splash/nyist-1.jpg',
  heroFilter = 0.2,
} = Astro.props;

const meta = [date, author ? `作者：${author}` : '', source ? `来源：${source}` : '']
  .filter(Boolean)
  .join(' · ');
---

<BaseLayout title={title} showHero tagline={meta} heroImage={heroImage} heroFilter={heroFilter}>
  <article class="prose">
    <div class="post__header">
      <h1>{title}</h1>
      <p class="post__meta">{meta}</p>
    </div>

    <slot />

    {
      (categories.length > 0 || tags.length > 0) && (
        <div class="post__footer">
          {categories.length > 0 && (
            <p>
              分类：
              {categories.map((name, index) => (
                <>
                  {index > 0 && '、'}
                  <a href={`/categories/${encodeURIComponent(name)}/`}>{name}</a>
                </>
              ))}
            </p>
          )}
          {tags.length > 0 && (
            <p>
              标签：
              {tags.map((name, index) => (
                <>
                  {index > 0 && '、'}
                  <a href={`/tags/${encodeURIComponent(name)}/`}>{name}</a>
                </>
              ))}
            </p>
          )}
        </div>
      )
    }
  </article>
</BaseLayout>
