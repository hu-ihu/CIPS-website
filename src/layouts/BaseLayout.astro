---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Masthead from '../components/Masthead.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../data/site';

interface Props {
  /** 页面标题；不传时用站点标题 */
  title?: string;
  description?: string;
  /** 是否显示顶部大图 hero */
  showHero?: boolean;
  tagline?: string;
  heroImage?: string;
  heroFilter?: number;
  action?: { label: string; url: string };
  /** 首页等宽版布局 */
  wide?: boolean;
  noindex?: boolean;
  /** 社交分享图（站内路径或绝对 URL），默认用 SITE.ogImage */
  image?: string;
  /** og:type：文章页传 article */
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  showHero = false,
  tagline,
  heroImage,
  heroFilter,
  action,
  wide = false,
  noindex = false,
  image = SITE.ogImage,
  type = 'website',
} = Astro.props;

// 首页传的 title 与站点标题相同，避免出现「CIPS @ NYIST - CIPS @ NYIST」
const pageTitle =
  !title || title === SITE.title ? `${SITE.title} - ${SITE.subtitle}` : `${title} - ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#9e1111" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/static/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/static/favicon/apple-icon.png" />
    <link rel="manifest" href="/static/favicon/manifest.json" />
    <link rel="alternate" type="application/rss+xml" title="CIPS 全部内容" href="/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="CIPS 新闻" href="/feed/news.xml" />
    <link rel="alternate" type="application/rss+xml" title="CIPS Planet" href="/feed/planet.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主内容</a>
    <Masthead />
    {
      showHero && (
        <PageHero title={title} tagline={tagline} image={heroImage} filter={heroFilter} action={action} />
      )
    }
    <main id="main" class={wide ? 'wrap wrap--wide' : 'wrap'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
